{
  "files.exclude": {
    "**/.local": true,
    "**/.venv": true,
    "**/venv": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/logs": true,
    "**/*.log": true,
    "**/*.tmp": true,
    "**/*.tsbuildinfo": true,
    "**/playwright-report": true,
    "**/test-results": true
  },
  "search.useIgnoreFiles": true,
  "search.exclude": {
    "**/.env": true,
    "**/backups": true,
    "**/pgdata": true,
    "**/private": true,
    "**/uploads": true
  },
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "[python]": {
    "editor.tabSize": 4
  },
  "[typescript][typescriptreact][json][jsonc]": {
    "editor.tabSize": 2
  }
}
